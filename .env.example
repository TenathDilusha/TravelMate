# Local PostgreSQL (used by Python API + import fallback)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=travelmate
DB_PORT=5432

# Import script / Neon-style names (optional; falls back to DB_* above)
NEON_DB_HOST=localhost
NEON_DB_USER=postgres
NEON_DB_PASSWORD=your_password
NEON_DB_NAME=travelmate
NEON_DB_PORT=5432

# Frontend → API URL
VITE_API_BASE_URL=http://localhost:8000

# App URLs used by OAuth redirects + cookie CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# JWT used inside the httpOnly session cookie
JWT_SECRET=change-me-to-a-long-random-secret

# Cookie flags (local: lax + secure=false; production cross-site: none + true)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook OAuth (https://developers.facebook.com/apps)
# Valid OAuth Redirect URI: http://localhost:8000/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
